# Optional. 8004scan serves anonymous traffic at 30 req/min, which this app stays
# inside via caching and a concurrency gate. A hackathon Pro key raises the limit
# to 3,000 req/min. Server-side only — never expose this to the browser.
SCAN_API_KEY=

# Override the API base if you need to point at a staging deployment.
# SCAN_BASE_URL=https://api.8004scan.io/api/v1

# Required to run the scheduled sweep endpoint (POST /api/sweep). Without it the
# endpoint refuses to run rather than exposing an unguarded outbound prober.
SWEEP_SECRET=

# Optional. Enables operator-funded testnet demo routes for trusted scripts.
# Keep this server-side: the public UI never receives or submits this secret.
POKTER_DEMO_WRITE_SECRET=

# Public origin embedded in ERC-8183 deliverable records. Set this to the
# deployed HTTPS origin before running the seller on a public environment.
# Local development deliberately falls back to http://localhost:4311.
# Apex domain to bind passkeys to, so a credential created on www also works
# on the bare domain. Leave empty to use whatever host the page was served
# from, which is right for localhost and preview deploys.
NEXT_PUBLIC_PASSKEY_RP_ID=

NEXT_PUBLIC_APP_URL=


# Where accumulated probe history is written. Local disk is correct for a
# long-running host; on an ephemeral serverless filesystem, point the store at a
# hosted database instead.
# PROBE_DB_PATH=./data/probes.db
# DELIVERABLE_DB_PATH=./data/deliverables.db

# Operator alerts — where Pokter tells its own team something happened.
# Nobody subscribes to these; they go to whoever runs the marketplace. Both
# channels are optional and independent: configure either, both, or neither.
# With neither set the watcher still runs and reports what it saw in the
# sweep response, it just has nowhere to shout.
#
# Telegram is the quickest to stand up and needs no domain verification.
# Create a bot with @BotFather, add it to the group, and read the chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates after posting there.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Email alerts reuse the Resend credentials the notification system already
# needs (RESEND_API_KEY, NOTIFICATION_FROM_EMAIL); this names the recipient.
OPERATOR_ALERT_EMAIL=
