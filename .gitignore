# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# The starter template is its own package; its install must never be
# committed. Without this, an `add -A` from the repo root sweeps in 12,577
# vendored files, which is how it happened once.
templates/*/node_modules
templates/*/package-lock.json
templates/*/.vercel
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Accumulated probe history (regenerated by sweeps; not source)
/data

# Screen recordings are hosted, not committed — see README.
*.mp4
*.mov
*.avi

# Working documents for the submission itself — the form answers, the demo
# script, the voiceover, the upload copy, the upstream issue drafts. They are
# how the submission was made, not part of what is being submitted, and a
# public repo carrying its own pitch notes reads oddly.
#
# Kept on disk deliberately: several are still needed to finish submitting.
docs/submission.md
docs/youtube.md
docs/form-copy.md
docs/voiceover.md
docs/demo-script.md
docs/demo-walkthrough.md
docs/cold-open-brief.md
docs/cold-open-prompt.md
docs/upstream/

# Working notes. Outreach drafts name publishers and their mistakes;
# this repository is public and that is not something to publish.
notes/

# The evaluator starter writes its attestation into the working directory,
# so running it from the repository root leaves one here. It is a reading
# taken at a moment, not source, and the published script is the thing
# worth keeping.
evaluator-attestation-*.json

# Kept local at the operator's request: opens a real Venus position with a
# real key. `git add -A` has swept a stray file into a commit once today,
# and this one signs transactions.
scripts/venus-testnet-position.mts

# Personal permission rules; not shared — see .claude/settings.local.json
.claude/settings.local.json

# Test screenshots show wallet addresses and balances; keep them on the machine that took them.
docs/release/*-screens/

# browser tests (tests/browser)
/.playwright/
# a fixture half-written when a recording server stopped (tests/browser/support/server-network.mjs)
tests/browser/fixtures/**/*.tmp
