# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# The starter template is its own package; its install must never be committed.
templates/*/node_modules
templates/*/package-lock.json
templates/*/.vercel
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Example files carry no secrets and are the setup instructions: a repo that
# ignores them documents an environment nobody can reproduce.
!.env.example
!templates/*/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Accumulated probe history (regenerated by sweeps; not source)
/data

# Screen recordings are hosted, not committed — see README.
*.mp4
*.mov
*.avi

# Working documents for the submission itself — the form answers, the demo
# script, the voiceover, the upload copy, the upstream issue drafts. They are
# how the submission was made, not part of what is being submitted, and a
# public repo carrying its own pitch notes reads oddly.
#
# Kept on disk deliberately: several are still needed to finish submitting.
docs/submission.md
docs/youtube.md
docs/form-copy.md
docs/voiceover.md
docs/demo-script.md
docs/demo-walkthrough.md
docs/cold-open-brief.md
docs/cold-open-prompt.md
docs/upstream/
