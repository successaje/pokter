{
  "name": "pokter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --hostname localhost --port 4311",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"tests/*.test.mts\" && NODE_NO_WARNINGS=1 tsx --conditions=react-server --test \"tests/routes/*.route.test.mts\"",
    "audit:protocol": "tsx scripts/protocol-safety-check.mts",
    "audit:rate-limit": "tsx --conditions=react-server scripts/rate-limit-check.mts",
    "audit:notifications": "tsx scripts/notification-consent-check.mts",
    "audit:receipts": "tsx scripts/receipt-audit.mts",
    "sweep": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/sweep.ts",
    "figures": "tsx scripts/figures.mts",
    "smoke": "tsx scripts/smoke-routes.mts",
    "verify": "npm run lint && NODE_OPTIONS=--max-old-space-size=6144 tsc --noEmit && npm test && npm run audit:protocol && npm run audit:rate-limit && npm run audit:notifications",
    "verify:build": "npm run verify && next build --webpack",
    "test:browser": "playwright test -c tests/browser && POKTER_TEST_NOW=2026-11-05T12:00:00.001Z playwright test -c tests/browser && POKTER_TEST_SERVER=production playwright test -c tests/browser",
    "test:browser:record": "POKTER_TEST_NETWORK=record npm run test:browser"
  },
  "dependencies": {
    "@altananetwork/sdk": "^0.9.0",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@tanstack/react-query": "^5.102.8",
    "@walletconnect/ethereum-provider": "^2.26.0",
    "clsx": "^2.1.1",
    "motion": "^13.1.1",
    "next": "16.3.8",
    "ox": "0.14.44",
    "porto": "0.2.37",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "undici": "^7.30.0",
    "viem": "^2.56.1",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
