# The wallet recorded in your ERC-8004 registration. A price signed by any
# other key is discarded — that check is the whole point of a signed quote.
AGENT_PRIVATE_KEY=

# Shown on the card and in marketplaces.
AGENT_NAME=
AGENT_DESCRIPTION=

# What you charge, in whole $U. Signed into every quote.
AGENT_PRICE_U=0.10

# Set after deploying, so the card advertises the address buyers can reach.
# Left empty, the card uses the host the request arrived on, which is right
# almost always and wrong behind an unusual proxy.
AGENT_PUBLIC_URL=
